{
  "name": "@seeghra/tokens",
  "version": "1.0.0",
  "description": "Seeghra design system: IBM Carbon v11 tokens set in Geist, with square corners and left alignment.",
  "license": "Apache-2.0",
  "author": "itsgrj",
  "homepage": "https://seeghra.github.io/seeghra/",
  "repository": { "type": "git", "url": "git+https://github.com/seeghra/seeghra.git" },
  "bugs": { "url": "https://github.com/seeghra/seeghra/issues" },
  "keywords": ["design-system", "design-tokens", "carbon", "carbon-design-system", "geist", "css-variables", "tokens"],
  "style": "dist/tokens.css",
  "main": "dist/tokens.json",
  "exports": {
    ".": "./dist/tokens.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./reference.html": "./docs/index.html",
    "./skill": "./skill/SKILL.md",
    "./package.json": "./package.json"
  },
  "files": ["dist", "docs", "skill", "fonts", "LICENSE", "NOTICE", "README.md", "CHANGELOG.md"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "node scripts/gen.js && node scripts/build.js"
  },
  "devDependencies": {
    "@carbon/colors": "11.60.0",
    "@carbon/icons": "11.90.0",
    "@carbon/layout": "11.61.0",
    "@carbon/motion": "11.54.0",
    "@carbon/styles": "1.117.0",
    "@carbon/themes": "11.83.0",
    "@carbon/type": "11.69.0",
    "geist": "1.8.1"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
